Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Map
      Name: Ball search grid
      Enabled: true
      Topic:
        Value: /world_model/search_grid
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.4
      Draw Behind: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Field
      Enabled: true
      Topic:
        Value: /world_model/field_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: World model
      Enabled: true
      Topic:
        Value: /world_model/markers
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Top view
      Enabled: false
      Topic:
        Value: /world_model/topview
      Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 300
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Height: 800
  Width: 1200
